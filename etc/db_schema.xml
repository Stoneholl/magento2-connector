<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="stoneholl_connector_state" resource="default" engine="innodb"
           comment="Stoneholl Connector Cached State">
        <column xsi:type="smallint" name="state_id" unsigned="true" nullable="false" identity="true"
                comment="State ID"/>
        <column xsi:type="varchar" name="connection_status" nullable="false" length="32" default="unpaired"
                comment="Connection Status"/>
        <column xsi:type="varchar" name="installation_id" nullable="true" length="36"
                comment="Remote Installation ID"/>
        <column xsi:type="varchar" name="environment" nullable="true" length="16"
                comment="Installation Environment"/>
        <column xsi:type="varchar" name="domain" nullable="true" length="253"
                comment="Normalized Installation Domain"/>
        <column xsi:type="timestamp" name="last_attempt_at" nullable="true" on_update="false"
                comment="Last Check Attempt"/>
        <column xsi:type="timestamp" name="last_success_at" nullable="true" on_update="false"
                comment="Last Successful Check"/>
        <column xsi:type="varchar" name="last_error_code" nullable="true" length="64"
                comment="Redacted Error Code"/>
        <column xsi:type="text" name="last_error_message" nullable="true"
                comment="Redacted Error Message"/>
        <column xsi:type="mediumtext" name="snapshot_json" nullable="true"
                comment="Normalized Cached API Snapshot"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="state_id"/>
        </constraint>
    </table>
</schema>
