{
    "name": "stoneholl/magento2-connector",
    "description": "Optional online account, entitlement, update, and service-status connector for Stoneholl Magento 2 modules.",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "~7.4.0||~8.0.0||~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "stoneholl/magento2-core": "^1.0.1",
        "magento/framework": "102.0.*||103.0.*",
        "magento/module-backend": "101.0.*||102.0.*",
        "magento/module-config": "101.1.*||101.2.*",
        "magento/module-cron": "100.3.*||100.4.*",
        "magento/module-store": "101.0.*||101.1.*",
        "magento/module-ui": "101.1.*||101.2.*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Stoneholl\\Connector\\": ""
        }
    },
    "replace": {
        "stoneholl/module-connector": "self.version"
    },
    "keywords": [
        "magento2",
        "magento",
        "magento 2",
        "magento2 module",
        "magento open source",
        "admin",
        "connector",
        "account pairing",
        "updates"
    ]
}
